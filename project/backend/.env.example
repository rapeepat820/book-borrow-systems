PORT=4000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=book_borrow_system

JWT_SECRET=yak kin mama

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# หมายเหตุ: ไม่ต้องตั้งค่า PROMPTPAY_ID อีกต่อไป — ระบบใช้ QR PromptPay แบบรูปคงที่
# (frontend/src/config/payment.js) แทนการสร้าง QR แบบไดนามิกต่อรายการแล้ว

# URL ของ frontend ที่ deploy จริง ใช้สร้างลิงก์ในอีเมล "ลืมรหัสผ่าน" และจำกัด CORS
# ตอน dev บนเครื่องปล่อยว่างไว้ได้ (จะอนุญาตทุกโดเมน)
FRONTEND_URL=

# Cloudinary — สำหรับเก็บรูปสลิป/หลักฐานการคืนแบบถาวรตอน deploy จริง (จำเป็นมาก ถ้าไม่ตั้งค่า
# รูปที่อัปโหลดจะหายเมื่อ redeploy บน hosting ที่ใช้พื้นที่เก็บไฟล์ชั่วคราวอย่าง Railway)
# สมัครฟรีได้ที่ https://cloudinary.com แล้วคัดลอกค่าจากหน้า Dashboard
# ตอน dev บนเครื่องปล่อยว่างไว้ได้ ระบบจะเก็บไฟล์ในดิสก์เครื่องแทนโดยอัตโนมัติ
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# เติมรูปปก/ปีที่พิมพ์/ฉบับที่/เล่มที่ ให้หนังสือที่ยังว่างอัตโนมัติทุกครั้งที่เปิดเซิร์ฟเวอร์ (ค่าเริ่มต้น = เปิด)
# ถ้าไม่ต้องการ ให้ตั้งเป็น false
AUTO_FILL_BOOKS=true


# ส่งอีเมล (OTP ลืมรหัสผ่าน ฯลฯ) ผ่าน Brevo HTTP API — แนะนำสำหรับ Railway (ที่มักบล็อก SMTP)
# สมัครฟรีที่ https://www.brevo.com → SMTP & API → API Keys แล้วยืนยันอีเมลผู้ส่งที่ Senders
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM_EMAIL=your_verified_sender@gmail.com
MAIL_FROM_NAME=RP Bookstore


# ตรวจสลิปโอนเงินอัตโนมัติ (ไม่บังคับ): ถ้าไม่ตั้งค่า ระบบจะอ่าน QR บนสลิปเพื่อกันสลิปปลอม/สลิปซ้ำ แล้วให้แอดมินยืนยันยอดเอง
# ถ้าตั้งค่า SlipOK (https://slipok.com) ระบบจะตรวจกับธนาคารและอนุมัติให้อัตโนมัติเมื่อยอดตรง
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# (ไม่บังคับ) ข้อความส่วนหนึ่งของชื่อผู้รับที่ต้องเห็นในสลิป เช่น ชื่อต้นของเจ้าของบัญชี (ชื่อในสลิปถูกปิดบางส่วน ใช้ส่วนต้นของชื่อ)
SLIP_RECEIVER_KEYWORD=


# ค่าปรับเกินกำหนดคืน (ไม่บังคับ): บาทต่อวัน (ค่าเริ่มต้น 10) และจำนวนวันที่ผ่อนผันก่อนเริ่มนับ (ค่าเริ่มต้น 0)
# ค่าปรับรวมไม่เกินค่ามัดจำของรายการนั้น และหักจากมัดจำตอนแอดมินยืนยันคืน
LATE_FEE_PER_DAY=10
LATE_FEE_GRACE_DAYS=0
# จำนวนวันทำการที่แจ้งลูกค้าในอีเมลว่าจะโอนมัดจำคืน (ค่าเริ่มต้น 3)
REFUND_WITHIN_DAYS=3


# ===== ยืนยันตัวตนสมาชิก (เลขบัตร + รูปบัตร + เซลฟี่) =====
# ตั้งเป็นข้อความสุ่มยาวๆ แล้ว "ห้ามเปลี่ยนภายหลัง" (ถ้าเปลี่ยน รูปที่รอตรวจและค่าแฮชเก่าจะอ่านไม่ได้)
ID_ENCRYPTION_KEY=
# ตั้งเป็น false เพื่อปิดการบังคับยืนยันตัวตน (ค่าเริ่มต้น = บังคับ)
REQUIRE_ID_VERIFICATION=true

# ===== ค่าส่ง: ขอราคาจริงจาก Flash Express (ต้องสมัครบัญชีธุรกิจ Flash เพื่อรับรหัส) =====
# ระบบทดลองของ Flash: FLASH_API_BASE=https://open-api-tra.flashexpress.com (ใช้รหัสของระบบทดลองคนละชุดกับระบบจริง)
FLASH_MCH_ID=
FLASH_SECRET_KEY=
FLASH_API_BASE=
# รหัสไปรษณีย์ต้นทางของร้าน (หรือตั้งในหน้าแอดมิน → คลังหนังสือ → บริษัทขนส่ง)
SHIP_FROM_POSTAL=

# ===== ยืมหลายเล่ม / จองคิว =====
MAX_BOOKS_PER_ORDER=5
# ชั่วโมงที่กันหนังสือไว้ให้ผู้จองคิวหลังมีเล่มว่าง (ค่าเริ่มต้น 48)
RESERVATION_HOLD_HOURS=48


# ค่ามัดจำ = กี่ % ของมูลค่าหนังสือ (ค่าเริ่มต้น 20 ปัดขึ้นเป็นหลักสิบบาท ขั้นต่ำ 10 บาท)
# ค่าต่ออายุยืมต่อครั้ง = เท่ากับค่ามัดจำของหนังสือเล่มนั้น
DEPOSIT_PERCENT=20
